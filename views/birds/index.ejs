<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bird Catalogue</title>
</head>
<body>
    <h1>Your Birds</h1>
    <ul>
        <% birds.forEach(bird => { %>
            <li><%= bird.name %></li>
        <% }); %>
    </ul>
    <a href="/birds/new">Add a new bird?</a>
</body>
</html>