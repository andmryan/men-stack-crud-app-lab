<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bird Catalogue</title>
</head>
<body>
    <h1>Your Birds</h1>
    <ul>
        <% birds.forEach(bird => { %>
            <li><a href="/birds/<%= bird._id%>"><%= bird.name %></a></li>
        <% }); %>
    </ul>
    <form action="/birds/new">
        <button type="submit">Catalogue a new bird?</button>
    </form>
</body>
</html>