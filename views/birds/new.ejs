<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add a Bird</title>
  </head>
  <body>
    <h1>Add a new bird to your catalogue!</h1>
    <form action="/birds" method="POST">
        <div>    
            <!-- Bird Name -->
             <input type="text" name="name" id="name" placeholder="Name"/></input>
        </div>
        <div>
            <!-- Bird Family -->
             <input type="text" name="family" id="family" placeholder="Family"/></input>
        </div>
        <div>
            <!-- Bird Description -->
             <textarea name="description" id="description" placeholder="Description"/></textarea>
        </div>
        <div>
            <!-- URL for bird image -->
             <input type="text" name="image" id="image" placeholder="Image URL"/></input>
        </div>
        <div>
            <!-- Submit Button -->
             <button type="submit">Catalogue it!</button>
             <!-- Back to catalogue  -->
             <form action="/birds">
              <button type="button">Back to your catalogue</button>
            </form>
        </div>
    </form>
  </body>
</html>